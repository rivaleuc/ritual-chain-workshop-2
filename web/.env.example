# Copy to web/.env.local

# Deployed RitualPredict, printed by hardhat/scripts/deploy.ts
NEXT_PUBLIC_PREDICT_ADDRESS=0x

# The oracle URL new markets are created with. The TEE executor performing the
# HTTP call runs off-chain and cannot reach localhost, so this has to be a
# publicly reachable URL:
#   cloudflared tunnel --url http://localhost:3000
NEXT_PUBLIC_DEMO_ORACLE_URL=http://localhost:3000/api/oracle/eth

# WalletConnect project id from https://cloud.reown.com
# Optional: injected wallets (MetaMask, Rabby) work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
